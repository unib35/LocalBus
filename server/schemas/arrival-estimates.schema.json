{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalBus arrival estimates v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "snapshotId",
    "generatedAt",
    "timezone",
    "validFrom",
    "validUntil",
    "enabled",
    "samples"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1
    },
    "timezone": {
      "const": "Asia/Seoul"
    },
    "enabled": {
      "type": "boolean"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "validFrom": {
      "type": "string",
      "format": "date-time"
    },
    "validUntil": {
      "type": "string",
      "format": "date-time"
    },
    "samples": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "routeId",
          "variantId",
          "routeVersion",
          "correctionVersion",
          "serviceDate",
          "departureMinute",
          "durationSeconds",
          "correctionSeconds",
          "fetchedAt",
          "source"
        ],
        "properties": {
          "routeId": {
            "type": "string",
            "minLength": 1
          },
          "variantId": {
            "type": "string",
            "minLength": 1
          },
          "routeVersion": {
            "type": "string",
            "minLength": 1
          },
          "correctionVersion": {
            "type": "string",
            "minLength": 1
          },
          "serviceDate": {
            "type": "string",
            "format": "date"
          },
          "departureMinute": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1439
          },
          "durationSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 21600
          },
          "correctionSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3600
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "enum": [
              "synthetic",
              "kakao-future"
            ]
          }
        }
      }
    }
  }
}
